init-vimext() {
    local repo
    local vim="${HOME}/.vim"
    local vimext="${vim}/pack/dist/start"

    local extensions=(
        "tpope/vim-sensible"
        "vim-airline/vim-airline"
        "vim-airline/vim-airline-themes"
    )

    mkdir -p "${vim}/autoload"
    curl -LSso "${vim}/autoload/pathogen.vim" https://tpo.pe/pathogen.vim

    mkdir -p "${vimext}"
    pushd "${vimext}" > /dev/null || return 1

    for repo in "${extensions[@]}"; do
        if [ ! -d "$(basename "${repo}")" ]; then
            git clone "https://github.com/${repo}"
        fi
    done

    popd > /dev/null || return 1
}

update-vimext() {
    local d
    local vim="${HOME}/.vim"
    local vimext="${vim}/pack/dist/start"

    mkdir -p "${vim}/autoload"
    curl -LSso "${vim}/autoload/pathogen.vim" https://tpo.pe/pathogen.vim

    for d in $(find "${vim}" -type d -name .git); do
        pushd "${d}/.." > /dev/null
        echo -e "\n$(pwd) =>"
        git pull
        git gc --quiet > /dev/null
        popd > /dev/null
    done
}
